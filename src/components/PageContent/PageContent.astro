---
import type { MarkdownHeading } from 'astro';
import Toc from '../PageContent/Toc.astro';
import CitationInteractions from '../Globals/CitationInteractions.astro';
import Hr from '../Globals/Hr.astro'

type Props = {
  title: string;
  headings: MarkdownHeading[];
  description: string;
  githubEditUrl: string;
  toc?: boolean;
};

const {
  title,
  headings,
  description,
  githubEditUrl,
  toc
} = Astro.props;
---

<article
  id="article"
  class="content mx-6 max-w-[700px] min-w-0"
>
  <section class="main-section">

    <header
      class="
        mt-10 mb-16
        font-roboto
      "
    >
      <h1
        class="
          m-0
          max-w-[10ch]
          text-[clamp(3rem,15vw,4.75rem)]
          sm:max-w-[10.5ch]
          sm:text-[clamp(3.25rem,8vw,5.35rem)]
          font-normal
          leading-[0.96]
          sm:leading-[0.94]
          tracking-[-0.043em]
          sm:tracking-[-0.046em]
          text-balance
        "
      >
        {title}
      </h1>

      <p
        class="
          mt-4
          sm:mt-[1.4rem]
          mb-2
          max-w-[28rem]
          sm:max-w-[34rem]
          text-[0.92rem]
          sm:text-[clamp(0.9rem,1.4vw,0.98rem)]
          font-light
          leading-[1.6]
          sm:leading-[1.58]
          tracking-[-0.003em]
          text-pretty
        "
      >
        {description}
      </p>

      <Hr/>
    </header>

    {toc && (
      <>
        <div class="flex w-full items-center justify-center py-2">
          <p class="heading">
            Content Outline
          </p>
        </div>

        <Toc />
      </>
    )}

    <slot />
  </section>

  <CitationInteractions />
</article>
