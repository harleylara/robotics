---
import BaseBlockInfo from "./BaseBlockInfo.astro";

export interface Props {
  term: string;
}

const { term } = Astro.props;
---

<BaseBlockInfo label="Definition" tone="green">
  <dfn
    slot="heading"
    class="not-italic text-base font-medium tracking-tight"
  >
    {term}
  </dfn>

  <slot />
</BaseBlockInfo>
